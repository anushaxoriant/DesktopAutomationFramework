{
    "version": "0.2.0",

    "configurations": [
        {
            "name": ".NET NUnit Debug",

            "type": "coreclr",

            "request": "launch",

            "program": "dotnet",

            "args": [
                "test",
                "--no-build",
                "--filter",
                "Name~VerifyReplaceFeature"
            ],

            "cwd": "${workspaceFolder}",

            "console": "integratedTerminal",

            "stopAtEntry": false
        }
    ]
}